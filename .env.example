# Plantilla de configuración. Copia a .env y rellena.
#   cp .env.example .env
# .env está en .gitignore. .env.example SÍ se versiona: es la documentación
# de qué variables necesita el proyecto, sin los valores.

# ---------------------------------------------------------------------------
# Azure DevOps
# ---------------------------------------------------------------------------
# Nombre de la organización, tal como aparece en https://dev.azure.com/<org>
AZDO_ORG=
# Nombre del proyecto dentro de esa organización
AZDO_PROJECT=
# Personal Access Token. Scopes MÍNIMOS para esta PoC (T0.2):
#   - Code: Read & Write
#   - Pull Request: Contribute
# Nada de "Full access". Este token puede escribir en tus repos.
AZDO_PAT=
# Repo que contiene el catálogo de plantillas (T0.3)
AZDO_REPO_PLANTILLAS=plantillas-ci
# Tag del catálogo al que se ancla el pin de los pipelines generados
AZDO_TAG_PLANTILLAS=v1.0.0

# ---------------------------------------------------------------------------
# Modelo
# ---------------------------------------------------------------------------
# gemini | lmstudio
# Ojo: el tier gratuito de Gemini son 20 peticiones AL DÍA. El recolector
# conversacional (T2.2) gasta una por turno, así que una sola conversación de
# prueba puede agotarla. Para desarrollo, lmstudio.
MODEL_BACKEND=lmstudio

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b
